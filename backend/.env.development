# Development Environment Configuration
PORT=3000
NODE_ENV=development

# Supabase (use development project)
SUPABASE_URL=https://dev-project.supabase.co
SUPABASE_SERVICE_KEY=dev-service-key
SUPABASE_ANON_KEY=dev-anon-key

# Firebase (use test project)
FCM_PROJECT_ID=jiffy-dev
# Add other FCM credentials...

# APIs (use test keys if available)
GIPHY_API_KEY=dev-giphy-key
TENOR_API_KEY=dev-tenor-key

# Development settings
CORS_ORIGIN=*
LOG_LEVEL=debug
RATE_LIMIT_MAX_REQUESTS=1000
