# JIFFY Backend Environment Variables
# Copy to .env and fill in your values

# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ==============================================
# SUPABASE CONFIGURATION
# Get from: https://supabase.com/dashboard
# ==============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================
# FIREBASE CLOUD MESSAGING (FCM)
# Get from: Firebase Console → Project Settings → Service Accounts
# ==============================================
FCM_PROJECT_ID=your-firebase-project
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# ==============================================
# GIF APIs (Optional but recommended)
# ==============================================

# GIPHY API
# Get from: https://developers.giphy.com
# Free tier: 42 req/hour, 1000 req/day
GIPHY_API_KEY=your_giphy_api_key_here

# Tenor API (Google)
# Get from: https://console.cloud.google.com
# Better free tier, used as fallback
TENOR_API_KEY=your_tenor_api_key_here

# ==============================================
# ANALYTICS (Optional)
# ==============================================

# PostHog (Backend event tracking)
# Get from: https://posthog.com
POSTHOG_API_KEY=phc_your_posthog_key_here
POSTHOG_HOST=https://app.posthog.com

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================
# Development: Use * for all origins
# Production: Set to your Android app domain
CORS_ORIGIN=*

# ==============================================
# TESTING (for .env.test)
# ==============================================
# Use separate Supabase project for testing
# TEST_SUPABASE_URL=https://your-test-project.supabase.co
# TEST_SUPABASE_SERVICE_KEY=...
